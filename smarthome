#!/usr/bin/env python3
"""
SmartHome CLI Controller
Usage:
  smarthome light [on|off|toggle|full|night]
  smarthome ac [on|off|cool|dry] [temp] [fan_mode]
  smarthome ac <temp>
  smarthome heater [on|off|heat|eco|plus|minus] [temp]
  smarthome cleaner [start|pause|home|stop|speed <mode>|find]
  smarthome vacuum ... (alias for cleaner)
  smarthome eufy ...   (alias for cleaner)
  smarthome usb [on|off|toggle|status]
  smarthome pc [status|shutdown]
  smarthome notification [title] <message>
  smarthome notify <message>
  smarthome status
  smarthome assistant "<natural language prompt>"
"""


import sys
import os
import json
import urllib.request
import urllib.error

DIRECTORY = os.path.dirname(os.path.realpath(__file__))
STATE_FILE = os.path.join(DIRECTORY, 'state.json')
CONFIG_FILE = os.path.join(DIRECTORY, 'config.json')

SERVER_URL = "http://127.0.0.1:8080"

def send_api_request(endpoint, data=None):
    """serve.pyのAPIにリクエストを送信して状態更新と家電操作を行う"""
    try:
        url = f"{SERVER_URL}{endpoint}"
        if data is not None:
            body = json.dumps(data).encode('utf-8')
            req = urllib.request.Request(url, data=body, headers={'Content-Type': 'application/json'})
        else:
            req = urllib.request.Request(url)
        with urllib.request.urlopen(req, timeout=5) as res:
            return json.loads(res.read().decode('utf-8'))
    except Exception as e:
        return direct_fallback(endpoint, data, e)

def direct_fallback(endpoint, data, original_error):
    sys.path.insert(0, DIRECTORY)
    try:
        import switchbot_client
        import eufy_client
        import state_manager
        
        state = state_manager.load_state()

        if endpoint == '/api/light':
            action = data.get('action', 'toggle')
            if action in ('on', 'turnOn', 'full', 'night'):
                state['lightOn'] = True
            elif action in ('off', 'turnOff'):
                state['lightOn'] = False
            elif action == 'toggle':
                state['lightOn'] = not state.get('lightOn', False)
                action = 'turnOn' if state['lightOn'] else 'turnOff'
            switchbot_client.control_light(action)
            res = {"status": "success", "message": f"Light: {action}", "state": state}

        elif endpoint == '/api/ac':
            mode = data.get('mode', 'cool')
            temp = int(data.get('temp', 26))
            fan = data.get('fan_mode', 'auto')
            state['acMode'] = mode
            state['acTemp'] = temp
            state['acFan'] = fan
            switchbot_client.control_ac(mode, temp, fan)
            res = {"status": "success", "message": f"AC: {mode} {temp}C {fan}", "state": state}

        elif endpoint == '/api/heater':
            action = data.get('action', 'heat')
            if action in ('on', 'turnOn', 'heat'):
                state['heaterMode'] = 'heat'
            elif action in ('off', 'turnOff'):
                state['heaterMode'] = 'off'
            switchbot_client.control_heater(action)
            res = {"status": "success", "message": f"Heater: {action}", "state": state}

        elif endpoint == '/api/cleaner':
            action = data.get('action', 'start')
            client = eufy_client.EufyG30Client()
            if action in ('start', 'play', 'resume'):
                client.play()
                state['cleanerStatus'] = 'running'
            elif action in ('pause',):
                client.pause()
                state['cleanerStatus'] = 'standby'
            elif action in ('stop', 'home', 'dock', 'return'):
                client.return_to_dock()
                state['cleanerStatus'] = 'recharge'
            res = {"status": "success", "message": f"Cleaner: {action}", "state": state}
        elif endpoint == '/api/usb':
            import usb_service
            if not data:
                power = usb_service.get_usb_power()
            else:
                action = data.get('action')
                if action == 'on': power = usb_service.set_usb_power(True)
                elif action == 'off': power = usb_service.set_usb_power(False)
                else: power = usb_service.toggle_usb_power()
            res = {"status": "success", "power": power}
        elif endpoint in ('/api/notify', '/api/notification'):
            import push_service
            title = data.get('title', 'SmartHome')
            message = data.get('message') or data.get('body', '')
            ongoing = data.get('ongoing', False)
            auto_cancel = data.get('auto_cancel', not ongoing)
            notif = push_service.push_notification(
                title=title,
                body=message,
                priority=data.get('priority', 'high'),
                actions=data.get('actions', []),
                notif_id=data.get('id'),
                progress=data.get('progress'),
                ongoing=ongoing,
                auto_cancel=auto_cancel,
                data=data.get('data'),
                tag=data.get('tag')
            )
        elif endpoint in ('/api/pc', '/api/pc/shutdown'):
            import pc_service
            if data and data.get('action') == 'shutdown':
                res = pc_service.shutdown_pc()
            else:
                res = pc_service.get_pc_status()
        else:
            res = {"status": "error", "message": str(original_error)}

        state_manager.save_state(state)
        return res
    except Exception as fallback_err:
        return {"status": "error", "message": f"API and fallback both failed: {original_error} / {fallback_err}"}


def cmd_light(args):
    action = args[0] if args else 'toggle'
    if action in ('on', 'turnon', '1'): action = 'on'
    elif action in ('off', 'turnoff', '0'): action = 'off'
    elif action in ('full', '100'): action = 'full'
    elif action in ('night', '常夜灯'): action = 'night'
    elif action in ('toggle', 't'): action = 'toggle'
    else:
        print(f"Unknown light action: {action}")
        print("Usage: smarthome light [on|off|toggle|full|night]")
        return False

    res = send_api_request('/api/light', {'action': action})
    print(f"ライト: {res.get('message', res.get('status'))}")
    return True

def cmd_ac(args):
    mode = 'cool'
    temp = 26
    fan = 'auto'

    if not args:
        mode = 'cool'
    else:
        for arg in args:
            arg_lower = arg.lower()
            if arg_lower in ('off', 'stop', 'turnoff', '0'):
                mode = 'off'
            elif arg_lower in ('cool', '冷房'):
                mode = 'cool'
            elif arg_lower in ('dry', '除湿'):
                mode = 'dry'
            elif arg_lower.isdigit():
                temp = int(arg_lower)
            elif arg_lower in ('auto', 'low', 'medium', 'high'):
                fan = arg_lower

    res = send_api_request('/api/ac', {'mode': mode, 'temp': temp, 'fan_mode': fan})
    if mode == 'off':
        print("エアコン: オフにしました")
    else:
        print(f"エアコン: {mode.upper()} {temp}℃ (風量: {fan}) に設定しました")
    return True

def cmd_heater(args):
    action = args[0] if args else 'heat'
    temp = 22
    if len(args) > 1 and args[1].isdigit():
        temp = int(args[1])

    if action in ('on', 'heat', '暖房', '1'): action = 'heat'
    elif action in ('off', '0'): action = 'off'
    elif action in ('eco', 'エコ'): action = 'eco'
    elif action in ('plus', '+', 'up'): action = 'plus'
    elif action in ('minus', '-', 'down'): action = 'minus'

    payload = {'action': action}
    if temp: payload['temp'] = temp

    res = send_api_request('/api/heater', payload)
    print(f"ヒーター: {res.get('message', res.get('status'))}")
    return True

def cmd_cleaner(args):
    action = args[0] if args else 'start'
    speed = None
    if action in ('start', 'run', 'clean', 'play', '掃除'): action = 'start'
    elif action in ('pause', 'stop_clean', '一時停止'): action = 'pause'
    elif action in ('home', 'dock', 'return', '充電', '帰還'): action = 'home'
    elif action in ('speed', 'モード'):
        action = 'speed'
        if len(args) > 1: speed = args[1]
    elif action in ('find', 'beep'): action = 'find_me'

    payload = {'action': action}
    if speed: payload['speed'] = speed

    res = send_api_request('/api/cleaner', payload)
    print(f"クリーナー: {res.get('message', res.get('status'))}")
    return True

def cmd_usb(args):
    action = args[0] if args else 'toggle'
    if action in ('on', '1', 'オン', '点灯', 'start'):
        action = 'on'
    elif action in ('off', '0', 'オフ', '消灯', 'stop'):
        action = 'off'
    elif action in ('toggle', 't', '切替', 'トグル'):
        action = 'toggle'
    elif action in ('status', 'stat', 's', '状態'):
        res = send_api_request('/api/usb')
        power = res.get('power', False)
        print(f"USBスイッチ: {'ON (オン)' if power else 'OFF (オフ)'}")
        return True

    res = send_api_request('/api/usb', {'action': action})
    power = res.get('power', False)
    print(f"USBスイッチ: {'ON (オン)' if power else 'OFF (オフ)'} にしました")
    return True

def cmd_pc(args):
    action = args[0].lower() if args else 'status'
    if action in ('status', 'stat', 's', 'info'):
        res = send_api_request('/api/pc')
        online = res.get('online', False)
        os_name = res.get('os', 'オフライン')
        ip = res.get('ip', '192.168.0.51')
        print(f"デスクトップPC ({ip}): {'起動中 [' + os_name + ']' if online else 'オフライン'}")
        return True
    elif action in ('shutdown', 'off', 'poweroff', 'down', '切る', '電源切る'):
        print("デスクトップPCへシャットダウンを要求しています...")
        res = send_api_request('/api/pc/shutdown', {'action': 'shutdown'})
        print(f"結果: {res.get('message', res.get('status'))}")
        return True
    else:
        print(f"Unknown PC action: {action}")
        print("Usage: smarthome pc [status|shutdown]")
        return False

def cmd_notification(args):
    if not args or args[0] in ('--help', '-h'):
        print("Usage: smarthome notification [title] <message> [options]")
        print("       smarthome notify <message>")
        print("Options:")
        print("  --title <title>          通知タイトルを指定")
        print("  --progress <val>         プログレスバー (0-100)")
        print("  --action <title:command> アクションボタンを追加 (例: --action '全消灯:いってきます')")
        print("  --reply                  Novaへのインライン返信ボタンを追加")
        print("  --id <notif_id>          通知ID（インプレース更新用）")
        print("  --test-away              外出時消し忘れ通知（全アクション付き）をテスト送信")
        print("  --test-progress          プログレスバーが進行するデモ通知を送信")
        return False

    if '--test-away' in args:
        import push_service
        notif = push_service.send_away_device_warning()
        if notif:
            print(f"外出時消し忘れ通知を送信しました: [{notif.get('title')}] (タイトル・ボタン類のみ)")
        else:
            print("電気等の稼働機器がないため、外出時通知は送信されませんでした。")
        return True

    if '--test-progress' in args:
        import time
        import push_service
        notif_id = "demo_progress"
        print("プログレスバー通知デモ開始...")
        for p in [10, 35, 60, 85, 100]:
            push_service.send_progress_notification(
                title="クリーナー",
                body=f"清掃中... ({p}%)" if p < 100 else "清掃が完了しました！",
                current=p,
                max_val=100,
                notif_id=notif_id,
                ongoing=(p < 100)
            )
            time.sleep(1)
        print("プログレスバー通知デモ完了！")
        return True

    title = "SmartHome"
    message_parts = []
    actions = []
    progress = None
    notif_id = None
    ongoing = False

    i = 0
    while i < len(args):
        arg = args[i]
        if arg == '--title' and i + 1 < len(args):
            title = args[i+1]
            i += 2
        elif arg == '--id' and i + 1 < len(args):
            notif_id = args[i+1]
            i += 2
        elif arg == '--progress' and i + 1 < len(args):
            try:
                pval = int(args[i+1])
                progress = {"current": pval, "max": 100, "indeterminate": False}
            except ValueError:
                pass
            i += 2
        elif arg == '--action' and i + 1 < len(args):
            act_str = args[i+1]
            if ':' in act_str:
                act_title, act_cmd = act_str.split(':', 1)
            else:
                act_title, act_cmd = act_str, act_str
            actions.append({"id": f"act_{len(actions)}", "title": act_title, "command": act_cmd})
            i += 2
        elif arg == '--reply':
            actions.append({"id": "reply_nova", "title": "💬 Novaに指示", "reply": True, "reply_placeholder": "Novaへの指示を入力..."})
            i += 1
        elif arg == '--ongoing':
            ongoing = True
            i += 1
        else:
            message_parts.append(arg)
            i += 1

    if not message_parts:
        message = "通知テスト"
    elif len(message_parts) == 1 and title == "SmartHome":
        message = message_parts[0]
    elif len(message_parts) >= 2 and title == "SmartHome":
        title = message_parts[0]
        message = " ".join(message_parts[1:])
    else:
        message = " ".join(message_parts)

    payload = {
        'title': title,
        'message': message,
        'actions': actions,
        'ongoing': ongoing
    }
    if progress: payload['progress'] = progress
    if notif_id: payload['id'] = notif_id

    res = send_api_request('/api/notify', payload)
    if res.get('status') == 'success':
        print(f"通知送信: [{title}] {message} (Actions: {len(actions)}, Progress: {bool(progress)})")
        return True
    else:
        print(f"通知送信失敗: {res.get('message', res.get('error', 'unknown error'))}")
        return False

def cmd_status():
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, 'r', encoding='utf-8') as f:
                state = json.load(f)
            print("=== SmartHome Current State ===")
            print(f"ライト:       {'ON (' + ('全灯' if state.get('lightFull') else ('常夜灯' if state.get('lightNight') else '点灯')) + ')' if state.get('lightOn') else 'OFF'}")
            print(f"エアコン:     {state.get('acMode', 'off').upper()} / {state.get('acTemp', 26)}℃ / 風量:{state.get('acFan', 'auto')}")
            print(f"ヒーター:     {state.get('heaterMode', 'off').upper()} / {state.get('heaterTemp', 24)}℃ / ECO:{state.get('heaterEco', False)}")
            print(f"クリーナー:   {state.get('cleanerStatus', 'standby').upper()}")
            print(f"USBスイッチ:  {'ON' if state.get('usbPower') else 'OFF'}")
            print(f"デスクトップPC: {'起動中 (' + state.get('pcOs', '不明') + ')' if state.get('pcOnline') else 'OFF'}")
            return
        except Exception:
            pass
    print("状態ファイルが読み込めませんでした。")

def main():
    if len(sys.argv) < 2:
        print(__doc__)
        return

    subcmd = sys.argv[1].lower()
    args = sys.argv[2:]

    if subcmd in ('light', 'l', 'ライト', '照明'):
        cmd_light(args)
    elif subcmd in ('ac', 'aircon', 'クーラー', 'エアコン', '冷房'):
        cmd_ac(args)
    elif subcmd in ('heater', 'h', 'ヒーター', '暖房'):
        cmd_heater(args)
    elif subcmd in ('cleaner', 'vacuum', 'eufy', 'c', 'v', '掃除機', 'ロボット掃除機'):
        cmd_cleaner(args)
    elif subcmd in ('usb', 'u', 'usbスイッチ', 'スイッチ'):
        cmd_usb(args)
    elif subcmd in ('pc', 'desktop', 'パソコン', 'デスクトップ'):
        cmd_pc(args)
    elif subcmd in ('notification', 'notify', 'n', '通知', 'notif'):
        cmd_notification(args)
    elif subcmd in ('status', 'stat', 's', '状態'):
        cmd_status()
    elif subcmd in ('assistant', 'ai', 'ask', 'nova', 'ノヴァ', 'ノバ'):
        prompt = " ".join(args)
        if not prompt and subcmd in ('nova', 'ノヴァ', 'ノバ'):
            prompt = subcmd
        res = send_api_request('/api/assistant', {'prompt': prompt})
        print(res.get('message', ''))
    else:
        print(f"Unknown command: {subcmd}")
        print(__doc__)

if __name__ == '__main__':
    main()

