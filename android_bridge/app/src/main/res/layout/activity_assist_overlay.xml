<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Floating Gemini Container (Bottom Aligned, Floating) -->
    <LinearLayout
        android:id="@+id/floatingContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        android:clickable="false">

        <!-- Top Floating Row: Small Dashboard Button (Left Aligned) -->
        <LinearLayout
            android:id="@+id/btnOpenDashboard"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="start"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_grid_view"
                app:tint="#2196f3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="ダッシュボード"
                android:textColor="#cbd5e1"
                android:textSize="13sp"
                android:textStyle="normal" />
        </LinearLayout>

        <!-- Floating Status / Response Bubble (Left Aligned) -->
        <LinearLayout
            android:id="@+id/statusContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:layout_gravity="start"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/loadingSpinner"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="お聞きしています..."
                android:textColor="#e2e8f0"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Gemini Floating Search / Input Pill (Matching Dashboard Nova bar) -->
        <LinearLayout
            android:id="@+id/searchPill"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <!-- Nova アイコン (Gemini風 キラキラ) - ダッシュボード完全準拠の40dp円形コンテナ -->
            <FrameLayout
                android:id="@+id/sparkleContainer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_sparkle_container">

                <ImageView
                    android:id="@+id/iconSparkle"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sparkle"
                    app:tint="#2196f3" />
            </FrameLayout>

            <EditText
                android:id="@+id/etCommand"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:background="@null"
                android:hint="Novaに話しかける..."
                android:textColor="#ffffff"
                android:textColorHint="#94a3b8"
                android:textSize="16sp"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:singleLine="true" />

            <!-- マイクボタン - ダッシュボード完全準拠の40dp円形ダークボタン -->
            <FrameLayout
                android:id="@+id/btnAction"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_mic_button_idle"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconAction"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    app:tint="#e2e8f0" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
