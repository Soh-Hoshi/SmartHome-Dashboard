<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Floating Gemini Container (Bottom Aligned, Floating) -->
    <LinearLayout
        android:id="@+id/floatingContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        android:clickable="false">

        <!-- Top Floating Row: Small Dashboard Button -->
        <LinearLayout
            android:id="@+id/btnOpenDashboard"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_open_dashboard"
                app:tint="#60a5fa" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="ダッシュボードを開く"
                android:textColor="#cbd5e1"
                android:textSize="12sp"
                android:textStyle="normal" />
        </LinearLayout>

        <!-- Floating Status / Response Bubble -->
        <LinearLayout
            android:id="@+id/statusContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/loadingSpinner"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="お聞きしています..."
                android:textColor="#e2e8f0"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Gemini Floating Search / Input Pill -->
        <LinearLayout
            android:id="@+id/searchPill"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iconSparkle"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_sparkle"
                app:tint="#3b82f6" />

            <EditText
                android:id="@+id/etCommand"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:background="@null"
                android:hint="話しかけるか、入力..."
                android:textColor="#ffffff"
                android:textColorHint="#64748b"
                android:textSize="16sp"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:singleLine="true" />

            <FrameLayout
                android:id="@+id/btnAction"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_mic_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconAction"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    app:tint="#ffffff" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
